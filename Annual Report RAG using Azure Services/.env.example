# Copy this file to .env and fill in the values.
# azure_setup/provision.sh prints every value below once it has created the resources.
# Never commit .env -- it holds keys.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names (provision.sh names each deployment after its model)
AZURE_OPENAI_GENERATION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GUARDRAIL_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=annual-reports

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=annual-reports

# --- Where upload_pdfs.py finds the four PDFs on your computer ---
LOCAL_PDF_DIR=./data/raw
