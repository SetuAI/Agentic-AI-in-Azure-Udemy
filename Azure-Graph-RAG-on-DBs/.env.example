# =============================================================================
# .env.example  -  TEMPLATE for your secrets file
# =============================================================================
# HOW TO USE (step by step, for a fresher):
#   1. Copy this file and name the copy ".env" (in the same folder).
#        Windows (PowerShell):  Copy-Item .env.example .env
#        Mac / Linux:           cp .env.example .env
#   2. Open .env and replace every <placeholder> and "replace-me" with your
#      real values from the Azure portal.
#   3. Never commit .env - it is listed in .gitignore so git skips it.
# The app reads these values at start-up with python-dotenv (load_dotenv()).
# Format of every line: NAME=value   (no spaces around "=", no quotes needed).
# =============================================================================

# Azure Database for PostgreSQL Flexible Server. sslmode=require: Azure refuses
# unencrypted connections.
# DATA_DB_URL = the database holding the mutual-fund business data (mf_data).
# Fill in <admin> (admin user name), <password> and <server> (server name).
DATA_DB_URL=postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/mf_data?sslmode=require
# AGENT_DB_URL = the agent's own database (agent_meta) that stores table/column
# descriptions, embeddings and join links (the "metadata" the agent searches).
AGENT_DB_URL=postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/agent_meta?sslmode=require

# Azure OpenAI: the URL of your Azure OpenAI resource (portal -> Keys and Endpoint).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Azure OpenAI: KEY 1 (or KEY 2) from the same "Keys and Endpoint" page.
AZURE_OPENAI_API_KEY=replace-me
# The DEPLOYMENT name of the chat model you created in Azure AI Foundry (writes SQL + answers).
CHAT_DEPLOYMENT=gpt-5.1
# The DEPLOYMENT name of the embedding model (turns text into vectors for search).
EMBED_DEPLOYMENT=text-embedding-3-small

# Azure AI Content Safety: endpoint of your Content Safety resource (Prompt Shields).
CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# Azure AI Content Safety: its key (portal -> Keys and Endpoint).
CONTENT_SAFETY_KEY=replace-me

# Application Insights connection string (portal -> your App Insights -> Overview).
# Leave it empty to switch Azure monitoring off while developing locally.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# LangSmith tracing (optional): set to true to send agent traces to LangSmith.
LANGSMITH_TRACING=false
# Your LangSmith API key (only needed when LANGSMITH_TRACING=true).
LANGSMITH_API_KEY=
# The LangSmith project name the traces are grouped under.
LANGSMITH_PROJECT=

