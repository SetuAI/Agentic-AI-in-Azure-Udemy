# =============================================================================
# .env  -  your settings and secrets (never commit this file)
# =============================================================================
# Format of every line: NAME=value   (no spaces around "=", no quotes needed).
# =============================================================================

# -----------------------------------------------------------------------------
# Log Analytics  (docs/azure/log-analytics.md)
# -----------------------------------------------------------------------------
# Your Log Analytics workspace -> Overview -> "Workspace ID".
LOG_ANALYTICS_WORKSPACE_ID=

# Your data collection rule -> JSON View -> the "logsIngestion" endpoint
# (it looks like https://<name>.<region>-1.ingest.monitor.azure.com).
LOGS_INGESTION_ENDPOINT=

# Your data collection rule -> Overview -> "Immutable Id" (starts with "dcr-").
DCR_IMMUTABLE_ID=

# ONLY if the Deployments_CL table got its own, second rule: that rule's Immutable Id.
# Leave it empty if both tables share one rule (the usual case).
DEPLOYMENTS_DCR_IMMUTABLE_ID=

# The stream names, from the rule's JSON View -> "streamDeclarations".
# The portal usually names them like this, so you rarely need to change them.
APP_LOGS_STREAM=Custom-AppLogs_CL
DEPLOYMENTS_STREAM=Custom-Deployments_CL

# -----------------------------------------------------------------------------
# Entra ID app  (docs/azure/entra-id.md)
# Used ON YOUR LAPTOP ONLY: to upload logs, and to search them while you test.
# Do NOT add these three on App Service; there the managed identity is used.
# -----------------------------------------------------------------------------
# App registrations -> your app -> Overview -> "Directory (tenant) ID".
AZURE_TENANT_ID=
# App registrations -> your app -> Overview -> "Application (client) ID".
AZURE_CLIENT_ID=
# App registrations -> your app -> Certificates & secrets -> the secret's "Value".
AZURE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------
# A long password you make up. Every AI app must send it to use the server.
# One way to make one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# The time zone the tools use for inputs and outputs.
DISPLAY_TIMEZONE=Asia/Kolkata